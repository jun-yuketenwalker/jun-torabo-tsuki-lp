#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

&pointing_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
};

/* === keymap-editor: gesture config (auto-generated, safe to regenerate) === */
/ {
    zip_gesture_trackpad: zip_gesture_trackpad {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        mode = <1>;
        bindings = <&zm_desktop_left>, <&zm_desktop_right>, <&zm_show_desktop>, <&zm_task_view>;
        tick = <40>;
        tap-ms = <10>;
    };
};

&pointing_listener {
    gesture_layer {
        layers = <12>;
        input-processors = <&zip_gesture_trackpad>;
    };
};
/* === keymap-editor: end gesture config === */
