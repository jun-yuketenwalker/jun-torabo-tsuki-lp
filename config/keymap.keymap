#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        mouse_btn4 {
            bindings = <&mkp MB4>;
            key-positions = <34 33>;
        };

        mouse_btn5 {
            bindings = <&mkp MB5>;
            key-positions = <35 34>;
        };

        mouse_btn4_low {
            bindings = <&mkp MB4>;
            key-positions = <47 48>;
        };

        mouse_btn5_low {
            bindings = <&mkp MB5>;
            key-positions = <48 49>;
        };
    };

    macros {
        parenthesis: parenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "PARENTHESIS";
        };

        blacket: blacket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "BLACKET";
        };

        brace: brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BRACE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans     &trans    &trans    &trans      &trans                                      &trans     &trans  &trans     &trans   &trans             &trans
&trans  &kp Q      &kp W     &kp E     &kp R       &kp T                                       &kp Y      &kp U   &kp I      &kp O    &kp P              &trans
&trans  &kp A      &kp S     &kp D     &kp F       &kp G      &trans            &trans         &kp H      &kp J   &kp K      &kp L    &lt 6 MINUS        &trans
&trans  &kp Z      &kp X     &kp C     &kp V       &kp B      &kp TAB           &kp BACKSPACE  &kp N      &kp M   &kp COMMA  &kp DOT  &lt 6 SLASH        &trans
&trans  &kp LCTRL  &kp LGUI  &kp LALT  &kp LSHIFT  &kp SPACE  &lt 2 LANGUAGE_2  &lt 1 LANG4    &kp ENTER  &trans  &trans     &to 4    &lt 7 PRINTSCREEN  &trans
            >;
        };

        Arrow_Number {
            bindings = <
&trans  &trans           &trans  &trans   &trans  &trans                     &trans           &trans          &trans          &trans           &trans      &trans
&trans  &kp KP_MULTIPLY  &kp N7  &kp N8   &kp N9  &kp PLUS                   &kp C_VOLUME_UP  &kp HOME        &kp UP_ARROW    &kp END          &kp DELETE  &trans
&trans  &kp SLASH        &kp N4  &kp N5   &kp N6  &kp MINUS  &trans  &trans  &kp C_VOL_DN     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans      &trans
&trans  &trans           &kp N1  &kp N2   &kp N3  &kp EQUAL  &trans  &trans  &trans           &trans          &trans          &trans           &trans      &trans
&trans  &trans           &kp N0  &kp DOT  &trans  &trans     &trans  &trans  &trans           &trans          &trans          &trans           &trans      &trans
            >;
        };

        Kigou {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                                 &trans                 &trans           &trans     &trans     &trans      &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp LEFT_BRACE                         &kp RIGHT_BRACE        &kp EXCLAMATION  &kp AT     &kp HASH   &kp DOLLAR  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp LEFT_BRACKET      &trans   &trans  &kp RIGHT_BRACKET      &kp PERCENT      &kp AMPS   &kp COLON  &kp SEMI    &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp LEFT_PARENTHESIS  &kp ESC  &trans  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE   &kp ASTRK  &brace     &trans      &trans
&trans  &trans  &trans   &trans   &trans   &trans                &trans   &trans  &trans                 &trans           &trans     &trans     &trans      &trans
            >;
        };

        YOBI {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Left_hand_device {
            bindings = <
&trans  &trans  &trans    &trans        &trans     &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &kp UP_ARROW  &trans     &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans        &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans        &trans     &trans  &trans  &trans  &trans  &trans  &trans  &to 0   &trans  &trans
            >;
        };

        Auto_Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };

        Auto_scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                              &trans                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                              &trans                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_AC_SCROLL_UP  &kp C_AC_SCROLL_DOWN  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans          &trans        &trans        &trans        &trans
            >;
        };
    };
};
