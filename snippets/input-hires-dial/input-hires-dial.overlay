#include <dt-bindings/zmk/keys.h>
#include <behaviors/hires_dial.dtsi>

/* Same I2C bus + 6-pin connector the left peripheral's input-trackpad-mini
 * snippet uses for the IQS7211E (see
 * snippets/input-trackpad-mini/input-trackpad-mini.overlay) -- the dial
 * module plugs into that same header instead of a new one. motion-gpios
 * reuses the old irq-gpios pin (gpio0 20).
 *
 * 2026-xx-xx: restored power-gpios on gpio0 8. First test build had zero
 * reaction from the dial at all (no rotation, no click) despite normal
 * typing/trackball working fine, which pointed at the sensor chip never
 * actually powering on rather than a wiring/position mistake specifically
 * in PUSH's path. gpio0 8 is very plausibly a power-enable line for
 * whichever sensor chip sits on this connector (trackpad or dial), not a
 * per-chip-specific signal -- restoring it is the more likely fix for
 * rotation. This also means gpio0 8 is NOT free for PUSH's kscan (see the
 * reverted block that used to sit below); PUSH's real GPIO is still
 * unidentified.
 */
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    hires_dial: hires_dial@75 {
        status = "okay";
        compatible = "sekigon,hires-dial";
        reg = <0x75>;
        motion-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        power-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H1)>;
        counts-per-revolution = <1275>;
    };
};

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&hires_dial>;
        triggers-per-rotation = <20>;
    };
};

&hires_dial_encoder { sensor = <&hires_dial>; };
&hires_dial_scroll { sensor = <&hires_dial>; };
&hires_dial_hscroll { sensor = <&hires_dial>; };
&hires_dial_radial_controller { sensor = <&hires_dial>; };

/* PUSH wiring attempt reverted (2026-xx-xx): it was placed on gpio0 8 via a
 * zmk,kscan-composite layered onto canonical position 0, but gpio0 8 turned
 * out to likely be the sensor's power-enable line instead (see the note on
 * the hires_dial node above) -- claiming it for both an output (power) and
 * an input (push) at once is a real conflict, and was probably why the
 * first test build got zero reaction from the dial at all, not just from
 * PUSH. Removed until PUSH's actual GPIO is identified. Position 0 is still
 * the intended landing spot once it is (see the keymap-editor.html comment
 * by DIAL_PUSH_POSITION for why that position is safe to reuse) -- the
 * kscan-composite approach itself should still be fine, it just needs the
 * right pin number.
 */

/* TEMPORARY for hardware debugging: layer_0 sends A/B instead of whatever
 * it's configured to in the editor, since "does rotating type a letter in
 * a text box" is the most unambiguous way to confirm the sensor is talking
 * to the MCU at all -- far easier to eyeball than a silent volume change or
 * an app-specific shortcut. Restore via the keymap-editor.html Dial tab
 * (it still has the real settings for every layer; this override doesn't
 * touch that state) once rotation is confirmed working.
 */
/* === keymap-editor: dial sensor-bindings (auto-generated, safe to regenerate) === */
&{/keymap/layer_0} { sensor-bindings = <&hires_dial_encoder A B>; };
&{/keymap/Flip_Right} { sensor-bindings = <&hires_dial_encoder C_VOLUME_UP C_VOLUME_DOWN>; };
&{/keymap/CLIP_STUDIO_1} { sensor-bindings = <&hires_dial_encoder APOSTROPHE MINUS>; };
&{/keymap/CLIP_STUDIO_2} { sensor-bindings = <&hires_dial_encoder RIGHT_BRACKET LEFT_BRACKET>; };
&{/keymap/CLIP_STUDIO_3} { sensor-bindings = <&hires_dial_encoder LA(LEFT_PARENTHESIS) LA(RIGHT_BRACKET)>; };
/* === keymap-editor: end dial sensor-bindings === */
