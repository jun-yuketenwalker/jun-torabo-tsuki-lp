#include <dt-bindings/zmk/keys.h>
#include <behaviors/hires_dial.dtsi>

/* Same I2C bus + GPIO pair the left peripheral's input-trackpad-mini snippet
 * uses for the IQS7211E (see snippets/input-trackpad-mini/input-trackpad-mini.overlay):
 * this board only has one spare GPIO slot per side, so the dial module takes
 * over the trackpad's connector instead of adding a new one. motion-gpios
 * reuses the old irq-gpios pin (gpio0 20), power-gpios reuses the old
 * power-gpios pin (gpio0 8).
 */
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    hires_dial: hires_dial@75 {
        status = "okay";
        compatible = "sekigon,hires-dial";
        reg = <0x75>;
        motion-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        power-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H1)>;
        counts-per-revolution = <1275>;
    };
};

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&hires_dial>;
        triggers-per-rotation = <20>;
    };
};

&hires_dial_encoder { sensor = <&hires_dial>; };
&hires_dial_scroll { sensor = <&hires_dial>; };
&hires_dial_hscroll { sensor = <&hires_dial>; };
&hires_dial_radial_controller { sensor = <&hires_dial>; };

/* The dial's PUSH signal is not a separate GPIO line -- the module clips into
 * the vacated key-switch socket (key position 44, physically the TAB/BACKSPACE/
 * ESC key depending on layer) and its click bridges that same row/col matrix
 * pair, just like the switch it replaced. So clicking the dial fires whatever
 * keymap.keymap already binds at position 44 on each layer -- no change
 * needed there, and &hires_dial_radial_controller_button (a normal keymap
 * binding, not a sensor-binding) is intentionally unused here.
 */

/* === keymap-editor: dial sensor-bindings (auto-generated, safe to regenerate) === */
&{/keymap/layer_0} { sensor-bindings = <&hires_dial_encoder C_VOLUME_UP C_VOLUME_DOWN>; };
/* === keymap-editor: end dial sensor-bindings === */
